{
  "$schema": "https://vercel.sh",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask",
      "functions": {
        "api/index.py": {
          "includeFiles": "data/**"
        }
      }
    },
    "api": {
      "root": "api",
      "framework": "django"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "app"
      }
    },
    { "source": "/pages/(.*)", "destination": "/frontend/pages/$1" },
    { "source": "/scripts/(.*)", "destination": "/frontend/scripts/$1" },
    { "source": "/styles/(.*)", "destination": "/frontend/styles/$1" },
    { "source": "/farmer.html", "destination": "/frontend/farmer.html" },
    {
      "source": "/transporter.html",
      "destination": "/frontend/transporter.html"
    },
    { "source": "/404.html", "destination": "/frontend/pages/404.html" },
    { "source": "/", "destination": "/frontend/pages/home.html" }
  ]
}
