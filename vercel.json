{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend_app": {
      "root": ".",
      "framework": "flask",
      "functions": {
        "api/index.py": {
          "includeFiles": "data/**"
        }
      }
    },
    "frontend_assets": {
      "root": "frontend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend_app"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend_app"
      }
    },
    {
      "source": "/pages/(.*)",
      "destination": {
        "service": "frontend_assets",
        "path": "/pages/$1"
      }
    },
    {
      "source": "/scripts/(.*)",
      "destination": {
        "service": "frontend_assets",
        "path": "/scripts/$1"
      }
    },
    {
      "source": "/styles/(.*)",
      "destination": {
        "service": "frontend_assets",
        "path": "/styles/$1"
      }
    },
    {
      "source": "/farmer.html",
      "destination": {
        "service": "frontend_assets",
        "path": "/farmer.html"
      }
    },
    {
      "source": "/transporter.html",
      "destination": {
        "service": "frontend_assets",
        "path": "/transporter.html"
      }
    },
    {
      "source": "/404.html",
      "destination": {
        "service": "frontend_assets",
        "path": "/pages/404.html"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend_assets",
        "path": "/pages/home.html"
      }
    }
  ]
}
