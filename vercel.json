{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend_app": {
      "root": "api",
      "framework": "flask"
    },
    "frontend_assets": {
      "root": "frontend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend_app",
        "path": "/index.py"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend_app",
        "path": "/index.py"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend_assets",
        "path": "/pages/home.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend_assets"
      }
    }
  ]
}
