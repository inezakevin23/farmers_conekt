{
  "$schema": "https://vercel.sh",
  "services": {
    "backend_app": {
      "root": ".",
      "framework": "flask",
      "functions": {
        "api/index.py": {
          "includeFiles": "data/**"
        }
      }
    },
    "frontend_assets": {
      "root": "frontend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend_app"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend_app"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend_assets",
        "path": "/pages/home.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend_assets"
      }
    }
  ]
}
