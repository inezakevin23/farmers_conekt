# ============================
# Farmer Conekt - environment template.
# Copy to .env (cp .env.example .env) and edit for your environment.
# Local MySQL defaults are used unless you switch to Aiven.
# ============================

# ---------- Database: MySQL ----------
# Local MySQL (default, used by `bash set_up.sh`):
DB_HOST=localhost
DB_USER=kevin
DB_PASSWORD=1234
DB_NAME=farmers_conekt
DB_PORT=3306
DB_SSL=false

# Aiven MySQL (set these to switch; Aiven MySQL commonly uses port 13306):
# DB_HOST=your-aiven-mysql-host.aivencloud.com
# DB_PORT=13306
# DB_SSL=true
# DB_SSL_CA=/absolute/path/to/ca.pem   (path to the Aiven CA, or paste the
#                                       CA PEM content directly)

# ---------- Media storage (Supabase) ----------
# MEDIA_BACKEND=local   (default) images are written to the local upload folder.
# MEDIA_BACKEND=supabase image bytes are uploaded to Supabase Storage.
MEDIA_BACKEND=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_BUCKET=crop-images

# ---------- Flutterwave ----------
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_REDIRECT_URL=https://your-app.vercel.app/pages/home.html?tab=orders
FLUTTERWAVE_CURRENCY=RWF

# ---------- Deployment (Vercel) ----------
JWT_SECRET_KEY=change_me_to_a_long_random_string
CORS_ORIGINS=
